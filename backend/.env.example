# LakeClean Mission Control — Environment Configuration Example

# Project Settings
PROJECT_NAME="LakeClean Mission Control"
ENVIRONMENT=development
DEMO_MODE=true

# Database: SQLite fallback used by default if DATABASE_URL is unset
# To use Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres
DATABASE_URL=

# Supabase Auth & Storage (Optional for cloud production)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication & Security
JWT_SECRET="lakeclean-super-secure-mission-control-jwt-secret-key-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Administrator Provisioning (Optional on startup or via create_admin.py)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME="System Administrator"

# SMTP Configuration (Optional: if unset, reset tokens log in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL="no-reply@lakeclean.demo"

# Mission Planning & Simulation Parameters
DEFAULT_BOAT_SPEED_KMH=4.5
BATTERY_DRAIN_PER_KM=12.0
BATTERY_DRAIN_PER_ZONE=4.0
CLEANING_TIME_PER_ZONE_MINUTES=12.0
DEFAULT_BATTERY_RESERVE_PCT=20.0
MAX_BIN_CAPACITY_KG=40.0
